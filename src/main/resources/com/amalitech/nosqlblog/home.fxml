<VBox alignment="TOP_CENTER" prefHeight="569.0" prefWidth="780.0" style="-fx-background-color: #ffffff;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.amalitech.nosqlblog.controller.HomeController">
